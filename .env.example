# SMTP auth only — server-side send credentials. Not shown on the website.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Activated FormSubmit endpoint hash for handymanprosflorida.com (support@ → lead inbox).
FORMSUBMIT_HASH=f9210c09be922a8d074ad29c70b1e68e
NEXT_PUBLIC_FORMSUBMIT_HASH=f9210c09be922a8d074ad29c70b1e68e

# Optional alternatives (any one works):
RESEND_API_KEY=
RESEND_FROM_EMAIL=Handyman Pros FL <onboarding@resend.dev>
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# AI (optional)
OPENAI_API_KEY=
